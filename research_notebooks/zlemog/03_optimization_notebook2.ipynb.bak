   "metadata": {},
   "outputs": [],
   "source": [
    "# Print study information to verify connection\n",
    "print(f\"Study name: {study.study_name}\")\n",
    "print(f\"Number of trials: {len(study.trials)}\")\n",
    "try:\n",
    "    best_trial = study.best_trial\n",
    "    print(f\"Best trial value: {best_trial.value}\")\n",
    "    print(\"Best trial parameters:\")\n",
    "    for param_name, param_value in best_trial.params.items():\n",
    "        print(f\"  {param_name}: {param_value}\")\n",
    "except ValueError as e:\n",
    "    print(\"No completed trials yet\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
