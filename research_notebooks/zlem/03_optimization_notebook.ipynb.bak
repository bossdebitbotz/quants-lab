    "# Launch the Optuna dashboard\n",
    "optimizer.launch_optuna_dashboard()\n",
    "\n",
    "\n",
    "await optimizer.optimize(\n",
    "    study_name=f\"zlem_2\",\n",
    "    config_generator=config_generator,\n",
    "    n_trials=10000,\n",
    "  # This will now work and run 4 parallel optimization jobs\n",
    ")\n",
    "optimizer.get_study_best_params(f\"zlem_2\")"
