   "source": [
    "# This is necessary to recognize the modules\n",
    "import os\n",
    "import sys\n",
    "import warnings\n",
    "\n",
    "warnings.filterwarnings(\"ignore\")\n",
    "\n",
    "root_path = os.path.abspath(os.path.join(os.getcwd(), '../..'))\n",
    "sys.path.append(root_path)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 2,
   "metadata": {},
   "outputs": [],
   "source": [
    "from core.services.timescale_client import TimescaleClient\n",
    "\n",
    "# Create test connection to the new backtesting database\n",
    "ts_client = TimescaleClient(\n",
    "    host=\"localhost\",\n",
    "    port=5433,  # Using the new port we specified\n",
    "    user=\"backtest_user\",\n",
    "    password=\"backtest_password\",\n",
    "    database=\"backtest_db\"\n",
    ")\n",
    "\n",
    "# Test connection\n",
    "await ts_client.connect()\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 3,
   "metadata": {},
   "outputs": [],
   "source": [
    "import datetime\n",
    "from core.backtesting.optimizer import StrategyOptimizer"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 4,
   "metadata": {},
   "outputs": [],
   "source": [
    "\n",
    "from research_notebooks.zlem.zlem_config_gen_simple import ZLEMAConfigGenerator\n",
    "# Define the date range for the optimization\n",
    "start_date = datetime.datetime(2024, 9, 1)\n",
    "end_date = datetime.datetime(2025, 3, 1)\n",
    "\n",
    "# Create the configuration generator\n",
    "config_generator = ZLEMAConfigGenerator(start_date=start_date, end_date=end_date)\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 5,
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Database unlocked successfully\n"
     ]
    }
   ],
   "source": [
    "if 'optimizer' in globals():\n",
    "    await optimizer.close()\n",
    "\n",
    "# Clean up any stale connections without deleting data\n",
    "import sqlite3\n",
    "\n",
    "def unlock_database():\n",
    "    try:\n",
    "        # Force close any existing connections\n",
    "        conn = sqlite3.connect('optuna.db')\n",
    "        conn.execute(\"PRAGMA busy_timeout = 5000\")\n",
    "        conn.execute(\"PRAGMA journal_mode = DELETE\")\n",
    "        conn.close()\n",
    "        print(\"Database unlocked successfully\")\n",
    "    except Exception as e:\n",
    "        print(f\"Error during unlock: {str(e)}\")\n",
    "\n",
    "unlock_database()"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 6,
   "metadata": {},
   "outputs": [
    {
     "name": "stderr",
     "output_type": "stream",
     "text": [
      "[I 2025-03-26 16:05:45,437] A new study created in RDB with name: zlem_1\n"
     ]
    },
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Study name: zlem_1\n",
      "Number of trials: 0\n"
     ]
    }
   ],
   "source": [
    "import optuna\n",
    "from optuna.storages import RDBStorage\n",
    "\n",
    "# Your existing TimescaleDB config\n",
    "timescale_config = {\n",
    "    \"host\": \"localhost\",\n",
    "    \"port\": 5433,\n",
    "    \"user\": \"backtest_user\",\n",
    "    \"password\": \"backtest_password\",\n",
    "    \"database\": \"backtest_db\"\n",
    "}\n",
    "\n",
    "# Create PostgreSQL connection string\n",
    "storage_url = (\n",
    "    f\"postgresql://{timescale_config['user']}:{timescale_config['password']}\"\n",
    "    f\"@{timescale_config['host']}:{timescale_config['port']}/{timescale_config['database']}\"\n",
    ")\n",
    "\n",
    "# Initialize storage with connection pooling\n",
    "storage = RDBStorage(\n",
    "    url=storage_url,\n",
    "    engine_kwargs={\n",
    "        'pool_size': 20,\n",
    "        'max_overflow': 0,\n",
    "        'pool_pre_ping': True\n",
    "    }\n",
    ")\n",
    "\n",
    "# Create study with TimescaleDB storage\n",
    "study = optuna.create_study(\n",
    "    study_name=\"zlem_1\",  # your study name\n",
    "    storage=storage,\n",
    "    direction=\"maximize\",  # or \"minimize\" depending on your objective\n",
    "    load_if_exists=True   # this will reuse the study if it exists\n",
    ")\n",
    "\n",
    "# Test the connection\n",
    "print(f\"Study name: {study.study_name}\")\n",
    "print(f\"Number of trials: {len(study.trials)}\")"
   ]
  },
