# TFT Bot Configuration - Environment Variables
# IMPORTANT: Copy this file to .env and modify as needed

# Model Configuration
DIR_MODEL_PATH=/app/models/directional_tft_20250502_134913.pt
DOWN_MODEL_PATH=/app/models/downward_specialist_tft_20250502_140300.pt
CONTEXT_LENGTH=20
EXPECTED_FEATURE_COUNT=64
MIN_FEATURES=20

# Ensemble & Trading Logic
ENSEMBLE_METHOD=selective
ENSEMBLE_THRESHOLD=0.002
TRADING_THRESHOLD=0.00015
POSITION_SIZING_ENABLED=true
POSITION_SIZE_BASE=0.01
POSITION_SIZE_FACTOR=0.0
POSITION_SIZE_FIXED=0.01
STOP_LOSS=0.01
TAKE_PROFIT=0.005
MAX_HOLDING_PERIOD=8
USE_DYNAMIC_THRESHOLD=true
FEE_PER_TRADE=0.0001

# Data Source
TRADING_PAIR=WLD-USDT
EXCHANGE_SYMBOL=WLDUSDT
PREDICTION_INTERVAL_SECONDS=60
DEPTH_STREAM_INTERVAL=100ms

# Binance API (Enter your own API keys for live trading)
BINANCE_API_KEY=3iIGyqMhfTP1HWnGNIYl1FkbwVUFsTIjsk6femk00tp42Id2AB0UOb3WZx710K6x
BINANCE_API_SECRET=dtkYFxkfiTM7YVwylvtIHEocRHxmC0z7jRCJO0KaugSP62SnlkqvikNc3Oe3aogM
BINANCE_BASE_URL=https://fapi.binance.com

# Database (TimescaleDB)
DB_HOST=host.docker.internal
DB_PORT=5441
DB_NAME=backtest_db
DB_USER=backtest_user
DB_PASSWORD=backtest_password

# Execution
ENABLE_LIVE_TRADING=true 